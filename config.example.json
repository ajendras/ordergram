{
    "bot_token": "123456:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "chat_id": -1001234567890,
    "poll_timeout": 30,
    "last_update_file": ".last_update_id",
    "outputs": [
        "console",
        "file"
    ],
    "webhook_url": "https://httpbin.org/post",
    "file_path": "orders.jsonl",
    "parse_patterns": {
        "detect": "/\\b(ORDER_PLACED|New Order|Order Confirmed)\\b/i",
        "order_id": "/Order(?:\\s+(?:ID|#))?\\s*[:=\\-]?\\s*([A-Z0-9\\-_]+)/i",
        "amount": "/(?:Total|Amount|Sum)[:\\s$€£]*\\s*([0-9]+(?:\\.[0-9]{1,2})?)/i",
        "currency": "/(USD|EUR|GBP|USDT|BTC)/i",
        "customer": "/(?:Customer|Client|User|Buyer)[:\\s]+([^\\n\\r]+)/i",
        "items": "/Items?[:\\s]+(.+?)(?:\\n|$)/i"
    }
}
